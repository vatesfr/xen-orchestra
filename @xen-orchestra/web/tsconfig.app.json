{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "./src/**/*",
    "./src/**/*.vue",
    "../web-core/env.d.ts",
    "../web-core/lib/**/*",
    "../web-core/lib/**/*.vue"
  ],
  "exclude": ["./src/**/*.unit.test.ts", "./src/**/*.unit.spec.ts", "./src/test/setup.ts"],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "rootDir": "..",
    "paths": {
      "@/*": ["./src/*"],
      "@core/*": ["../web-core/lib/*"]
    }
  }
}
