{
  "private": false,
  "name": "@xen-orchestra/async-map",
  "version": "0.1.5",
  "license": "ISC",
  "description": "Promise.all + map for all iterables",
  "keywords": [
    "array",
    "async",
    "iterable",
    "map",
    "settled",
    "typescript"
  ],
  "homepage": "https://github.com/vatesfr/xen-orchestra/tree/master/@xen-orchestra/async-map",
  "bugs": "https://github.com/vatesfr/xen-orchestra/issues",
  "repository": {
    "directory": "@xen-orchestra/async-map",
    "type": "git",
    "url": "https://github.com/vatesfr/xen-orchestra.git"
  },
  "author": {
    "name": "Vates SAS",
    "url": "https://vates.fr"
  },
  "preferGlobal": false,
  "main": "dist/index.cjs",
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "./index.js": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "./legacy": {
      "types": "./dist/legacy.d.cts",
      "default": "./dist/legacy.cjs"
    },
    "./legacy.js": {
      "types": "./dist/legacy.d.cts",
      "default": "./dist/legacy.cjs"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=14"
  },
  "dependencies": {
    "lodash": "^4.18.0"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist/",
    "dev": "tsc --watch",
    "postversion": "npm publish",
    "prebuild": "rimraf dist/",
    "predev": "yarn run prebuild",
    "test": "tsc && node --test \"dist/**/*.test.cjs\""
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/lodash": "^4.17.0",
    "@types/node": "^22.0",
    "rimraf": "^6.0.1",
    "typescript": "~5.6",
    "typescript-eslint": "^8.61.0"
  }
}
