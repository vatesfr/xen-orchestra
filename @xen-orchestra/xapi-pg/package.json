{
  "name": "@xen-orchestra/xapi-pg",
  "version": "1.0.0",
  "description": "Save XAPI entities to PostgresSQL",
  "license": "AGPL-3.0-or-later",
  "main": "index.js",
  "bugs": "https://github.com/vatesfr/xen-orchestra/issues",
  "repository": {
    "directory": "@xen-orchestra/fs",
    "type": "git",
    "url": "https://github.com/vatesfr/xen-orchestra.git"
  },
  "preferGlobal": true,
  "private": false,
  "dependencies": {
    "@xen-orchestra/log": "^0.7.2",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.4",
    "@electric-sql/pglite-socket": "^0.1.4"
  },
  "//": "--experimental-test-isolation=none is necessary because of the bug https://github.com/nodejs/node/issues/66860 , it causes the coverage to overestimate",
  "scripts": {
    "test": "node --experimental-test-isolation=none --test --experimental-test-coverage  test/*.test.mjs",
    "test-integration": "node --test test-integration/*.integ.mjs",
    "test-all": "node --experimental-test-isolation=none --test --experimental-test-coverage --test-coverage-include=src/*.mjs test/*.test.mjs test-integration/*.integ.mjs"
  }
}
