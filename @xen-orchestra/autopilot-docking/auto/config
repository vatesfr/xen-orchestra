#!/bin/sh
# live-build configuration of the docking ISO. Run through `lb config`.
set -e

lb config noauto \
	--distribution trixie \
	--archive-areas main \
	--security true \
	--updates true \
	--apt-recommends false \
	--binary-images iso-hybrid \
	--bootloaders syslinux,grub-efi \
	--uefi-secure-boot disable \
	--debian-installer none \
	--memtest none \
	--firmware-binary false \
	--firmware-chroot false \
	--iso-volume XO-DOCKING \
	--iso-application "VAPD : VMS Auto-pilot docking" \
	--iso-publisher "Vates" \
	--bootappend-live "boot=live components live-media=removable noswap quiet" \
	"${@}"
