  "bin": {
    "vates-everpure": "dist/cli.mjs"
  },
  "license": "ISC",
  "private": false,
  "type": "module",
  "description": "Client for the Everpure (Pure Storage FlashArray) REST API 2.x: volume snapshots and changed/allocated block listing",
